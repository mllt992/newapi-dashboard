# ===== docker-compose 环境变量 =====
# 复制为 .env 后按需修改：cp .env.example .env

# --- 数据库（必填）---
# new-api 的 MySQL DSN，仅需 SELECT 权限即可
# 格式：user:password@tcp(host:port)/database
SQL_DSN=user:password@tcp(host:3306)/database_name

# --- Redis（容器内置，按需改密码/端口）---
# docker-compose 启动的 redis 容器密码与对外端口
REDIS_PASSWORD=123456
REDIS_PORT=6379

# --- 应用 ---
# 宿主机映射端口（容器内部固定 3002）
APP_PORT=16302

# Token 数 → 美元的换算系数；用于"花费"统计，与 new-api 计费口径保持一致
# 默认 0.0001 表示 1 token ≈ $0.0001。可按实际渠道平均价校正。
COST_RATE=0.0001

# WebSocket 实时指标推送间隔（毫秒），默认 30000=30s
REFRESH_INTERVAL=30000
